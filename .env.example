# ============ Okkults Quant Execution — configuration template ============
# cp .env.example .env   then paste your keys, or simply run `python main.py`
# and let the terminal onboarding wizard write this file for you.
#
# SECURITY: broker keys and the license key stay on this machine — never
# committed, never logged, never transmitted anywhere except to Alpaca.

# --- Okkults signal server ------------------------------------------------
# License key minted from your account at okkults.okkults.workers.dev
OKKULTS_LICENSE_KEY=

# Signal stream (rarely needs changing)
OKKULTS_WS_URL=wss://okkults-api.okkults.workers.dev/v1/stream

# --- Broker ---------------------------------------------------------------
# alpaca = fully implemented | ibkr = COMING SOON (private beta)
BROKER=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper is the safe default. Flipping this to false trades REAL MONEY and
# also requires LIVE_TRADING_ACK=YES (the wizard writes it only after you
# type the acknowledgment).
ALPACA_IS_PAPER=true
LIVE_TRADING_ACK=NO

# --- Execution behavior ---------------------------------------------------
# full_auto = fires the moment the WebSocket signal lands
# semi_auto = renders the batch, waits for Enter/Spacebar (requires a TTY)
EXECUTION_MODE=full_auto

# --- Risk caps (sizing IS the stop-loss; no resting stops are placed) ------
# Total simultaneous exposure ceiling. Hard cap: 0.30.
MAX_PORTFOLIO_RISK_PCT=0.30
# Target allocation per ticker. Default 0.05, hard cap 0.10.
MAX_TRADE_ALLOCATION_PCT=0.05
# Optional USD hard cap per single order (blank = no cap)
#PER_TRADE_NOTIONAL_CAP=
# Dollars held back from sizing (blank defaults to 0)
CASH_RESERVE=0.0
# SELL signals open shorts only when explicitly enabled. Default off.
ALLOW_SHORT_SELLING=false

# --- Local failsafe ---------------------------------------------------------
# If the 9:30:15 AM EXIT_SIGNAL never arrives (server outage) and positions
# opened by this client are still open, liquidate them at 9:30:16 AM ET.
# Unrelated broker holdings are never touched.
LOCAL_EXIT_FAILSAFE=true
